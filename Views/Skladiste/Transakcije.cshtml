@model IEnumerable<GroupedTransakcija>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Transakcije";
}

<div class="container">
    <h2 class="mb-4">Prošle Transakcije</h2>

    @if (!Model.Any())
    {
        <p class="alert alert-info">Nema dostupnih transakcija.</p>
    }
    else
    {
        @foreach (var group in Model)
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5>@group.Tip - @group.Datum.ToString("dd.MM.yyyy HH:mm") - Kreirao: @(group.Korisnik?.Ime) @(group.Korisnik?.Prezime)</h5>
                    <a class="btn btn-primary btn-sm" href="@Url.Action("GeneratePdfForBatch", new { batchId = group.BatchId })">Preuzmi PDF</a>
                </div>
                <div class="card-body">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Materijal</th>
                                <th>Količina</th>
                                <th>Jedinica</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stavka in group.Stavke)
                            {
                                <tr>
                                    <td>@(stavka.Materijal?.Naziv ?? "N/A")</td>
                                    <td>@stavka.Kolicina</td>
                                    <td>@(stavka.Materijal?.Jedinica.ToString() ?? "N/A")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>
@section Scripts {
    <script>
        $('#transakcijeTable').DataTable({
            language: { url: 'https://cdn.datatables.net/plug-ins/1.13.4/i18n/hr.json' },
            pageLength: 25,
            order: [[8, 'desc']],
            columnDefs: [
                { targets: 8, visible: false }  
            ]
        });
    </script>
}